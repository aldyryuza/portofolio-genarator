# =============================================================================
# Personal Portfolio CMS — server (Docker) settings
#
#   cp .env.example .env
#   then fill in the two values marked  >>> REQUIRED <<<  and run
#   docker compose up -d        (see docs/DOCKER.md)
#
# Local development instead? Set APP_ENV=local, APP_DEBUG=true,
# APP_URL=http://localhost:8000 and your local DB_* values.
# =============================================================================

APP_NAME="Personal Portfolio"
APP_ENV=production
APP_DEBUG=false

# >>> REQUIRED <<< Your public address (used for links, sitemap and QR codes).
APP_URL=https://your-domain.com

# >>> REQUIRED <<< Generate once, then never change it (it decrypts sessions and tokens):
#   docker compose run --rm --no-deps --entrypoint php app artisan key:generate --show
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Docker ------------------------------------------------------------------
# nginx listens on 127.0.0.1:WEB_PORT; point your HTTPS reverse proxy at it.
# Pick a port that is free on the server (check with: ss -ltnp | grep :8090).
WEB_PORT=8090

# Bundled MySQL: not exposed outside Docker, so it never clashes with another
# MySQL on the server. The app connects as root. Applied only when the database
# volume is first created; change before the first `docker compose up`.
DOCKER_DB_DATABASE=portofolio
DOCKER_DB_PASSWORD=root

# Used only without Docker (compose.yaml sets these itself).
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=portofolio
DB_USERNAME=root
DB_PASSWORD=root

# --- Sessions ----------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Turn on once the site is served over HTTPS (login stops working over plain HTTP).
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Mail (contact-form notifications) ----------------------------------------
# "log" only writes mails to the log. For real delivery use smtp and fill in the rest.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Portfolio CMS -----------------------------------------------------------
# Media stays on a private disk and is served through the app.
PORTFOLIO_MEDIA_DISK=local
# Must stay below Livewire's 12 MB temporary upload limit.
PORTFOLIO_MAX_IMAGE_KB=8192
PORTFOLIO_MAX_DOCUMENT_KB=10240

# Behind a reverse proxy outside Docker: proxy IPs (comma-separated) or *.
# compose.yaml already sets * for the Docker setup.
# TRUSTED_PROXIES=
